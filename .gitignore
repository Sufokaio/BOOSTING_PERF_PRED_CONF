# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Tests / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Generated outputs (keep source .py files inside output/) ─────────────────
# Default run (no --tag)
output/results/
output/checkpoint.json
output/figures/*.png
output/figures/*.pdf
output/figures/*.svg
output/figures/*.eps
output/latex/*.tex

# Tagged runs — output/<tag>/ is fully generated, never commit (except 'final')
output/*/
!output/final/
!output/final/**
!output/paper_final/
!output/paper_final/**
!output/val/
output/val/*
!output/val/val_raw.csv
!output/val/hinnperf_time/
output/val/hinnperf_time/*
!output/val/hinnperf_time/hinnperf_pred_time.csv
output/*.zip
*.log

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db
